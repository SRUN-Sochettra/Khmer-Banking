# Database Connection
# Runtime (pooled) - used by the app
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Migrations (direct) - used by prisma migrate/push
DATABASE_URL_DIRECT="postgresql://user:password@host/dbname?sslmode=require"

# Next Auth
# Generate a secret using: npx auth secret
AUTH_SECRET=""

# Resend (Email Service)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vibe Banking"
